# Postgres connection string used by Prisma.
# For Supabase, copy the "Connection string" from Project Settings -> Database.
DATABASE_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres?sslmode=require"

# Supabase project URL and API keys.
NEXT_PUBLIC_SUPABASE_URL="https://<PROJECT-REF>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<SUPABASE_ANON_KEY>"
SUPABASE_SERVICE_ROLE_KEY="<SUPABASE_SERVICE_ROLE_KEY>"

# Storage bucket name used for uploaded PDF files.
SUPABASE_PDF_BUCKET="pdfs"

# Next.js runtime/application variables.
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT="3000"
