generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Text {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  sourcePdf String?
  versions  TextVersion[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model TextVersion {
  id               String            @id @default(cuid())
  textId           String
  text             Text              @relation(fields: [textId], references: [id], onDelete: Cascade)
  versionNumber    Int
  rawContent       String
  extractedContent String
  romanizedContent String
  lines            TextVersionLine[]
  tags             TextVersionTag[]
  createdAt        DateTime          @default(now())

  @@unique([textId, versionNumber])
}

model TextVersionLine {
  id               String      @id @default(cuid())
  textVersionId    String
  textVersion      TextVersion @relation(fields: [textVersionId], references: [id], onDelete: Cascade)
  lineNumber       Int
  rawContent       String
  extractedContent String
  romanizedContent String

  @@unique([textVersionId, lineNumber])
}

model Tag {
  id           String           @id @default(cuid())
  name         String           @unique
  textVersions TextVersionTag[]
}

model TextVersionTag {
  textVersionId String
  tagId         String
  textVersion   TextVersion @relation(fields: [textVersionId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([textVersionId, tagId])
}
